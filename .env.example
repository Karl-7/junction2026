# Copy to .env and fill in the keys for the providers you want to run. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_MODE=responses        # or "chat" for Chat Completions / OpenAI-compatible endpoints
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
